#!/usr/bin/env bash
# pre-push darnlink WHOLE-REPO wall, offline: the web-check needs the network and runs only in CI. Config: darnlink-gate.json.
set -euo pipefail
command -v darnlink-gate >/dev/null 2>&1 || { echo "darnlink pre-push: darnlink-gate no en PATH -> SALTO (CI cubre)." >&2; exit 0; }
export DARNLINK_GATE_WEB=0
exec darnlink-gate
